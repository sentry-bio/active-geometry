# Active Geometry .gitignore
# ===========================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# PyTorch
*.pt
*.pth
*.ckpt
checkpoints/
results/

# Data (too large for git)
raw_genomes/
*.fasta
*.fna
*.fa
*.fastq
*.fq
*.zst
!validation/**/*.yaml

# Lean
.lake/
lake-packages/
build/

# Mathematica
*.nb.bak

# Output
figures/outputs/*.png
figures/outputs/*.pdf

# OS
.DS_Store
Thumbs.db

# Logs
*.log
wandb/

# Temporary
*.tmp
*.temp
.cache/

# Verification outputs (generated)
validation/_executed/
verification_report.json

# Large data outputs (generated)
data/outputs/
